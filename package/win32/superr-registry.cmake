#
# superr-registry.cmake
#
# SUPERR CHANGE: Windows installer identity for SuperR. Included at the end
# of package/win32/CMakeLists.txt, so it replaces the upstream RStudio values
# set above it. SuperR installs beside an existing RStudio:
#
#  - its own directory, uninstall entry, Start Menu shortcut and registry key
#  - file types are only *offered* ("Open with" lists, OpenWithProgids); the
#    default program of .R, .Rproj, .Rmd, .qmd, .RData ... is never changed
#  - the uninstaller removes SuperR's own keys (SuperR.* ProgIDs, the
#    SuperR.exe entries); RStudio.* ProgIDs and other programs' values are
#    never touched
#
# SPDX-License-Identifier: AGPL-3.0-only
#

set(SUPERR_EXE "${SUPERR_executableName}.exe")
set(_classes "Software\\\\Classes")
set(_app "${_classes}\\\\Applications\\\\${SUPERR_EXE}")

# values the NSIS template reads (CPack forwards CPACK_* variables only)
set(CPACK_SUPERR_PRODUCT_NAME "${SUPERR_productName}")
set(CPACK_SUPERR_EXE "${SUPERR_EXE}")
set(CPACK_SUPERR_DISPLAY_VERSION "${SUPERR_DISPLAY_VERSION}")
string(REGEX MATCH "[0-9]+$" _prerelease_number "${SUPERR_prerelease}")
if(_prerelease_number STREQUAL "")
   set(_prerelease_number 0)
endif()
set(CPACK_SUPERR_NUMERIC_VERSION "${SUPERR_version}.${_prerelease_number}")
set(CPACK_SUPERR_NOTICE "${SUPERR_notice}")

set(CPACK_NSIS_INSTALLED_ICON_NAME "${SUPERR_EXE}")
set(CPACK_PACKAGE_INSTALL_REGISTRY_KEY "${SUPERR_registryKey}")
set(CPACK_PACKAGE_EXECUTABLES "${SUPERR_executableName}" "${SUPERR_productName}")
set(CPACK_PACKAGE_FILE_NAME "${SUPERR_productName}-${SUPERR_DISPLAY_VERSION}-Windows-x64")

# installer artwork generated by tools/superrstudio/branding/make-branding.ps1
set(_art "${RSTUDIO_PROJECT_ROOT}/assets/branding/generated")
set(CPACK_NSIS_MUI_ICON "${_art}/superr.ico")
set(CPACK_NSIS_MUI_UNIICON "${_art}/superr.ico")
string(REPLACE "/" "\\\\" CPACK_PACKAGE_ICON "${_art}/installer-header.bmp")
set(CPACK_NSIS_MUI_WELCOMEFINISHPAGE_BITMAP "${_art}/installer-welcome.bmp")
set(CPACK_NSIS_MUI_UNWELCOMEFINISHPAGE_BITMAP "${_art}/installer-welcome.bmp")

# ProgID suffix | description | icon resource | extensions
set(SUPERR_FILE_TYPES
   "Rproj|R Project File|-2|.Rproj"
   "r|R File|-3|.R"
   "rprofvis|R Profile File|-3|.Rprofvis"
   "css|CSS File|-4|.css"
   "html|HTML File|-5|.htm,.html"
   "js|JavaScript File|-6|.js"
   "markdown|Markdown File|-7|.md,.mdtxt,.markdown"
   "quarto|Quarto Markdown File|-8|.qmd"
   "rdata|R Data File|-9|.rda,.RData"
   "rdoc|R Doc File|-10|.Rd"
   "rhtml|R HTML File|-11|.Rhtml"
   "rmarkdown|R Markdown File|-12|.Rmd,.Rmarkdown"
   "rpres|R Presentation File|-13|.Rpres"
   "rnw|Sweave File|-14|.Rnw"
   "rtex|Sweave File|-14|.Rtex"
   "tex|TeX File|-15|.tex")

# extensions offered in "Open with" for the executable itself
set(SUPERR_OPEN_WITH .R .RData .rda .Rd .Rnw .Rmd .Rmarkdown .qmd .Rhtml .Rpres
   .Rproj .tex .Rtex .md .mdtxt .markdown .htm .html .css .js .c .cpp .h .hpp
   .py .Rprofvis)
set(SUPERR_SUPPORTED_TYPES .R .RData .rda .Rd .Rnw .Rmd .Rmarkdown .qmd .Rhtml
   .Rpres .Rproj .tex .Rtex .py .Rprofvis)

set(_open "'$INSTDIR\\\\${SUPERR_EXE} \\\"%1\\\"'")
set(_install "
   WriteRegStr SHCTX 'Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\App Paths\\\\${SUPERR_EXE}' '' '$INSTDIR\\\\${SUPERR_EXE}'
   WriteRegStr SHCTX '${_app}' 'FriendlyAppName' '${SUPERR_productName}'
   WriteRegStr SHCTX '${_app}\\\\shell\\\\open\\\\command' '' ${_open}
")
set(_uninstall "
   DeleteRegKey SHCTX 'Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\App Paths\\\\${SUPERR_EXE}'
   DeleteRegKey SHCTX '${_app}'
")
foreach(_ext ${SUPERR_SUPPORTED_TYPES})
   string(APPEND _install "   WriteRegStr SHCTX '${_app}\\\\SupportedTypes' '${_ext}' ''\n")
endforeach()
foreach(_ext ${SUPERR_OPEN_WITH})
   string(APPEND _install "   WriteRegStr SHCTX '${_classes}\\\\${_ext}\\\\OpenWithList\\\\${SUPERR_EXE}' '' ''\n")
   string(APPEND _uninstall "   DeleteRegKey SHCTX '${_classes}\\\\${_ext}\\\\OpenWithList\\\\${SUPERR_EXE}'\n")
endforeach()
foreach(_type ${SUPERR_FILE_TYPES})
   string(REPLACE "|" ";" _fields "${_type}")
   list(GET _fields 0 _suffix)
   list(GET _fields 1 _description)
   list(GET _fields 2 _icon)
   list(GET _fields 3 _extensions)
   set(_progid "${SUPERR_progIdPrefix}.${_suffix}")
   string(APPEND _install "
   WriteRegStr SHCTX '${_classes}\\\\${_progid}' '' '${_description}'
   WriteRegStr SHCTX '${_classes}\\\\${_progid}\\\\DefaultIcon' '' '$INSTDIR\\\\${SUPERR_EXE},${_icon}'
   WriteRegStr SHCTX '${_classes}\\\\${_progid}\\\\shell\\\\open\\\\command' '' ${_open}
")
   string(APPEND _uninstall "   DeleteRegKey SHCTX '${_classes}\\\\${_progid}'\n")
   string(REPLACE "," ";" _extensions "${_extensions}")
   foreach(_ext ${_extensions})
      string(APPEND _install "   WriteRegStr SHCTX '${_classes}\\\\${_ext}\\\\OpenWithProgids' '${_progid}' ''\n")
      string(APPEND _uninstall "   DeleteRegValue SHCTX '${_classes}\\\\${_ext}\\\\OpenWithProgids' '${_progid}'\n")
   endforeach()
endforeach()
string(APPEND _install "
   System::Call 'Shell32::SHChangeNotify(i 0x8000000, i 0, i 0, i 0)'
")
set(CPACK_NSIS_EXTRA_INSTALL_COMMANDS "${_install}")
set(CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS "${_uninstall}")
